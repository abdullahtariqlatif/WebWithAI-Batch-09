# Copy to .env and fill in:  cp .env.example .env

# ---- LLM (format is "provider:model") ----
# Groq — free key at https://console.groq.com/keys
# Other Groq models: groq:llama-3.3-70b-versatile, groq:openai/gpt-oss-20b, groq:llama-3.1-8b-instant
LLM_MODEL=groq:openai/gpt-oss-120b
GROQ_API_KEY=
# OpenAI instead:  LLM_MODEL=openai:gpt-5-mini  and set OPENAI_API_KEY=

# ---- Embeddings (for RAG) ----
# Groq has no embedding models, so by default a Hugging Face model runs locally
# on your CPU via FastEmbed — free, no key. Downloaded on first use (~130 MB).
EMBEDDING_MODEL=fastembed:BAAI/bge-small-en-v1.5
# Changed the embedding model? Rebuild the index:  uv run python -m scripts.ingest

# ---- Chroma vector store ----
# Leave CHROMA_API_KEY empty to store vectors locally in ./chroma_db
# Fill these in to use Chroma Cloud (https://trychroma.com → your database → Connect)
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
# CHROMA_COLLECTION=real_estate_knowledge

# ---- LangSmith tracing (optional) — https://smith.langchain.com ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=real-estate-ai

# ---- Langfuse tracing (optional) — https://cloud.langfuse.com or self-hosted ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---- App ----
# DATABASE_URL=sqlite:///./real_estate.db   (default: real_estate.db in this folder)
API_URL=http://localhost:8000
